-        + cfg.lambda_relight * relight
-        + cfg.lambda_anchor * anchor
-        + cfg.lambda_normal * normal_reg
-        + cfg.lambda_opacity * opacity_reg
-        + cfg.lambda_scale * rough_reg
-        + cfg.lambda_ortho * ortho_reg
