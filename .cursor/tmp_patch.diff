-@dataclass
-class LossWeights:
-    """Weights for the composite diffusion + physics loss."""
-
-    lambda_diffusion: float = 1.0
-    lambda_divergence: float = 0.5
-    lambda_coarse: float = 0.7
-    lambda_energy: float = 0.2
-
-
-@dataclass
-class TrainConfig:
-    """Configuration for training and optimization."""
-
-    epochs: int = 5
-    learning_rate: float = 2e-4
-    grad_clip: float = 1.0
-    device: str = "cpu"
-    seed: int = 0
-    diffusion: DiffusionConfig = DiffusionConfig(timesteps=400)
