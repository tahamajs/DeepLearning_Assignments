-class ConsistencyUNet(nn.Module):
-    """Student network g_φ mapping x_t -> x_{t-1} for nowcasting."""
-
-    def __init__(self, cfg: ModelConfig):
-        super().__init__()
-        self.cfg = cfg
-        c = cfg.base_channels
-        tdim = cfg.time_dim
-        self.time_mlp = TimeMLP(tdim)
-
-        self.input_proj = nn.Conv2d(cfg.in_channels, c, kernel_size=3, padding=1)
-        self.down1 = DownBlock(c, c, tdim, cfg.dropout)
-        self.down2 = DownBlock(c, c * 2, tdim, cfg.dropout)
-        self.mid1 = ResidualBlock(c * 2, c * 2, tdim, cfg.dropout)
-        self.mid2 = ResidualBlock(c * 2, c * 2, tdim, cfg.dropout)
-        self.up1 = UpBlock(c * 2, c, tdim, cfg.dropout)
-        self.up2 = UpBlock(c, c, tdim, cfg.dropout)
-
-        self.out_norm = nn.GroupNorm(num_groups=8, num_channels=c)
-        self.out_head = nn.Conv2d(c, 1, kernel_size=3, padding=1)
-
-    def forward(self, x_t: Tensor, timesteps: Tensor) -> Tuple[Tensor, Dict[str, Tensor]]:
-        """Forward pass with strict shape checks.
-
-        Args:
-            x_t: Noisy radar frame (B, C, H, W) where C = context length.
-            timesteps: Integer diffusion steps (B,).
-
-        Returns:
-            pred: One-step prediction with shape (B, 1, H, W).
-            aux: Dict with activation norms for regularization.
-        """
-
-        assert x_t.dim() == 4, "x_t must be BCHW"
-        b, _, h, w = x_t.shape
-        assert h % 4 == 0 and w % 4 == 0, "height and width must be divisible by 4"
-        assert timesteps.shape[0] == b, "timestep batch mismatch"
-
-        t_emb = sinusoidal_embedding(timesteps, self.cfg.time_dim).to(x_t.device)
-        t_emb = self.time_mlp(t_emb)
-
-        norms: List[Tensor] = []
-        x = self.input_proj(x_t)
-        x, skip1, n1 = self.down1(x, t_emb)
-        norms.extend(n1)
-        x, skip2, n2 = self.down2(x, t_emb)
-        norms.extend(n2)
-
-        x, n_mid1 = self.mid1(x, t_emb)
-        x, n_mid2 = self.mid2(x, t_emb)
-        norms.extend([n_mid1, n_mid2])
-
-        x, n_up1 = self.up1(x, skip2, t_emb)
-        norms.extend(n_up1)
-        x, n_up2 = self.up2(x, skip1, t_emb)
-        norms.extend(n_up2)
-
-        x = self.out_norm(x)
-        pred = self.out_head(F.silu(x))
-        if self.cfg.output_activation == "tanh":
-            pred = torch.tanh(pred)
-        elif self.cfg.output_activation == "sigmoid":
-            pred = torch.sigmoid(pred)
-
-        aux = {
-            "act_norm_mean": torch.stack(norms).mean(),
-            "act_norm_max": torch.stack(norms).max(),
-        }
-        return pred, aux
-
-
-def ema_update(model: nn.Module, ema_model: nn.Module, decay: float) -> None:
-    """In-place EMA update of ``ema_model`` parameters from ``model``."""
-
-    with torch.no_grad():
-        msd = model.state_dict()
-        esd = ema_model.state_dict()
-        for k, v in msd.items():
-            esd[k].copy_(decay * esd[k] + (1.0 - decay) * v)
-
-
-def build_models(
-    in_channels: int = 4,
-    base_channels: int = 64,
-    time_dim: int = 128,
-    dropout: float = 0.0,
-    output_activation: str = "tanh",
-) -> Tuple[ConsistencyUNet, ConsistencyUNet]:
-    """Factory returning (student, teacher_ema) with identical initialization."""
-
-    cfg = ModelConfig(
-        in_channels=in_channels,
-        base_channels=base_channels,
-        time_dim=time_dim,
-        dropout=dropout,
-        output_activation=output_activation,
-    )
-    student = ConsistencyUNet(cfg)
-    teacher = ConsistencyUNet(cfg)
-    teacher.load_state_dict(student.state_dict())
-    return student, teacher
