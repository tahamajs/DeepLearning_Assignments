-def _to_device(batch: Dict[str, Tensor], device: torch.device) -> Dict[str, Tensor]:
-    return {k: v.to(device) for k, v in batch.items()}
-
-
-def _downscale_average(field: Tensor, factor: int) -> Tensor:
-    """Average pooling that matches the synthetic block-averaging process."""
-
-    assert field.dim() == 4, "field must be BCHW"
-    assert field.shape[-1] % factor == 0 and field.shape[-2] % factor == 0, "spatial dims must divide evenly"
-    return F.avg_pool2d(field, kernel_size=factor, stride=factor)
-
-
-def compute_losses(
-    outputs: Dict[str, Tensor],
-    batch: Dict[str, Tensor],
-    loss_weights: LossWeights,
-    eps: Tensor,
-    coarse_factor: int,
-) -> Dict[str, Tensor]:
-    """Composite loss tying diffusion denoising with physical constraints."""
-
-    eps_hat = outputs["eps_hat"]
-    x0_phys = outputs["x0_phys"]
-    x0_hat = outputs["x0_hat"]
-
-    target_hr = batch["highres"]
-    target_lr = batch["coarse"]
-
-    # Diffusion denoising objective
-    loss_diff = F.mse_loss(eps_hat, eps)
-
-    # Physics penalties
-    loss_div = divergence(x0_phys).pow(2).mean()
-    coarse_pred = _downscale_average(x0_phys, factor=coarse_factor)
-    loss_coarse = F.mse_loss(coarse_pred, target_lr)
-    ke_pred = kinetic_energy(x0_phys)
-    ke_true = kinetic_energy(target_hr)
-    loss_energy = (ke_pred - ke_true).pow(2).mean()
-
-    total = (
-        loss_weights.lambda_diffusion * loss_diff
-        + loss_weights.lambda_divergence * loss_div
-        + loss_weights.lambda_coarse * loss_coarse
-        + loss_weights.lambda_energy * loss_energy
-    )
-
-    return {
-        "total": total,
-        "diffusion": loss_diff,
-        "divergence": loss_div,
-        "coarse": loss_coarse,
-        "energy": loss_energy,
-        "x0_hat": x0_hat,
-    }
