-def sample_noisy_inputs(x0: Tensor, t: Tensor, schedule: DownscalingDiffusion) -> Tensor:
-    """Draw Gaussian noise and produce x_t using the fixed schedule."""
-
-    noise = torch.randn_like(x0)
-    alpha_bar = schedule.schedule.extract(schedule.schedule.alpha_bar, t, x0.shape)
-    x_t = torch.sqrt(alpha_bar) * x0 + torch.sqrt(1.0 - alpha_bar) * noise
-    return x_t, noise
