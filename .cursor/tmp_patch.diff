-class UpBlock(nn.Module):
-    """Upsample + concatenate skip connection + residual refinement."""
-
-    def __init__(self, in_ch: int, out_ch: int, time_dim: int, dropout: float = 0.0):
-        super().__init__()
-        self.up = nn.ConvTranspose2d(in_ch, out_ch, kernel_size=4, stride=2, padding=1)
-        self.block1 = ResidualBlock(out_ch * 2, out_ch, time_dim, dropout)
-        self.block2 = ResidualBlock(out_ch, out_ch, time_dim, dropout)
-
-    def forward(self, x: Tensor, skip: Tensor, t: Tensor) -> Tuple[Tensor, List[Tensor]]:
-        x = self.up(x)
-        assert x.shape[-2:] == skip.shape[-2:], "upsample spatial mismatch"
-        x = torch.cat([x, skip], dim=1)
-        x, n1 = self.block1(x, t)
-        x, n2 = self.block2(x, t)
-        return x, [n1, n2]
