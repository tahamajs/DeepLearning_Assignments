-    assert pred_src.shape == target.shape, "photometric target shape mismatch"
-    assert pred_relit.shape == target_rel.shape, "relighting target shape mismatch"
-
-    photometric = (pred_src - target).abs().mean()
-    relight = (pred_relit - target_rel).abs().mean()
-
-    anchor = (
-        aux_src["anchor_l2"]
-        + aux_relit["anchor_l2"]
-        + aux_src["anchor_sparsity"]
-        + aux_relit["anchor_sparsity"]
-    ) * 0.25
-    normal_reg = 0.5 * (aux_src["normal_unit_error"] + aux_relit["normal_unit_error"])
