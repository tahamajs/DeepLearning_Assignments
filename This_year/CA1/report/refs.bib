  year           = {2014},
  url            = {https://arxiv.org/abs/1412.6980},
  archiveprefix  = {arXiv},
  eprint         = {1412.6980},
  primaryclass   = {cs.LG},
  abstract       = {This paper introduces Adam (Adaptive Moment Estimation), an adaptive optimization algorithm that combines the advantages of RMSProp and momentum. Adam computes adaptive learning rates for each parameter using estimates of first and second moments of the gradients. The algorithm is computationally efficient, requires little memory, and is well-suited for problems with large datasets and/or parameters. Adam has become one of the most widely used optimization algorithms in deep learning, particularly effective for training large neural networks. The paper provides theoretical convergence guarantees and empirical evidence of Adam's superior performance compared to other optimization methods.},
  keywords       = {optimization, Adam, adaptive learning rates, stochastic gradient descent, deep learning, convergence},
  citation_count = {50000+},
  impact_factor  = {most widely used optimizer in deep learning},
  note           = {Adam has become the default optimization algorithm for training deep neural networks due to its adaptive learning rates and computational efficiency.}
}

