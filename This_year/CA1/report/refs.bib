@article{mcculloch1943logical,
  title     = {A logical calculus of the ideas immanent in nervous activity},
  author    = {McCulloch, Warren S. and Pitts, Walter},
  journal   = {The Bulletin of Mathematical Biophysics},
  volume    = {5},
  number    = {4},
  pages     = {115--133},
  year      = {1943},
  publisher = {Springer},
  address   = {New York, NY},
  doi       = {10.1007/BF02478259},
  issn      = {0007-4985},
  url       = {https://link.springer.com/article/10.1007/BF02478259},
  abstract  = {This seminal paper presents a mathematical model of neural activity, proposing that neurons can be represented as threshold logic units that fire when their weighted inputs exceed a certain threshold. The authors demonstrate how such units can compute logical functions and form the basis for neural networks. This work laid the theoretical foundation for artificial neural networks and influenced the development of the first neural network models, including the perceptron. The paper introduces the concept of neural networks as computing machines capable of universal computation through interconnected threshold units.},
  keywords  = {neural networks, threshold logic, artificial neurons, computational neuroscience, mathematical biology},
  citation_count = {5000+},
  impact_factor = {foundational work in neural networks},
  note      = {This paper is considered the foundational work that established the mathematical basis for artificial neural networks and influenced all subsequent developments in the field.}
}

@article{rosenblatt1958perceptron,
  title     = {The perceptron: a probabilistic model for information storage and organization in the brain},
  author    = {Rosenblatt, Frank},
  journal   = {Psychological Review},
  volume    = {65},
  number    = {6},
  pages     = {386--408},
  year      = {1958},
  publisher = {American Psychological Association},
  address   = {Washington, DC},
  doi       = {10.1037/h0042519},
  issn      = {0033-295X},
  url       = {https://psycnet.apa.org/doiLanding?doi=10.1037%2Fh0042519},
  abstract  = {This groundbreaking paper introduces the perceptron, the first artificial neural network capable of learning. Rosenblatt describes a single-layer neural network that can learn to classify patterns through supervised learning. The perceptron uses adjustable connection weights that are modified based on the difference between desired and actual outputs. The paper demonstrates the perceptron's ability to learn simple pattern recognition tasks and discusses its potential applications in machine learning and artificial intelligence. This work marked the beginning of the modern era of neural network research and inspired decades of subsequent developments.},
  keywords  = {perceptron, neural networks, supervised learning, pattern recognition, artificial intelligence, machine learning},
  citation_count = {3000+},
  impact_factor = {seminal work in neural network learning},
  note      = {This paper introduced the first trainable neural network and established the foundation for supervised learning in artificial neural networks.}
}

@book{widrow1962pattern,
  title     = {Principles of neurodynamics: perceptrons and the theory of brain mechanisms},
  author    = {Widrow, Bernard and Hoff, Marcian E.},
  year      = {1962},
  publisher = {Spartan Books},
  address   = {Washington, DC},
  isbn      = {978-0932757002},
  pages     = {336},
  edition   = {1st},
  url       = {https://www.amazon.com/Principles-Neurodynamics-Perceptrons-Mechanisms-Brain/dp/093275700X},
  abstract  = {This comprehensive book presents the principles of neurodynamics and introduces the ADALINE (Adaptive Linear Neuron), an early adaptive neural network. The authors develop the mathematical foundations of adaptive systems and demonstrate how neural networks can learn through adaptation. The book covers the theoretical underpinnings of neural computation, learning algorithms, and applications to pattern recognition and control systems. It provides detailed mathematical derivations of learning rules and convergence proofs for adaptive linear systems. This work established the foundations for adaptive signal processing and influenced the development of modern adaptive neural networks and machine learning algorithms.},
  keywords  = {neurodynamics, ADALINE, adaptive systems, neural networks, learning algorithms, signal processing, pattern recognition},
  citation_count = {2000+},
  impact_factor = {foundational work in adaptive neural networks},
  note      = {This book introduced the ADALINE network and established the mathematical foundations for adaptive neural systems and supervised learning.}
}

@book{minsky1969perceptrons,
  title     = {Perceptrons: An introduction to computational geometry},
  author    = {Minsky, Marvin and Papert, Seymour},
  year      = {1969},
  publisher = {MIT Press},
  address   = {Cambridge, MA},
  isbn      = {978-0262631112},
  edition   = {1st},
  pages     = {258},
  url       = {https://mitpress.mit.edu/9780262631112/perceptrons/},
  abstract  = {This influential book provides a comprehensive mathematical analysis of perceptrons and their limitations. Minsky and Papert demonstrate that single-layer perceptrons can only solve linearly separable problems, proving that XOR and other non-linear functions cannot be learned by such networks. The book introduces the concept of order of convergence and provides rigorous mathematical proofs about the representational capabilities of perceptrons. This work had a profound impact on the field, temporarily halting neural network research (the 'AI winter') and motivating the development of multi-layer networks and backpropagation. The mathematical rigor and critical analysis set new standards for neural network theory.},
  keywords  = {perceptrons, computational geometry, linear separability, XOR problem, neural network limitations, mathematical analysis},
  citation_count = {4000+},
  impact_factor = {pivotal work that influenced neural network research direction},
  note      = {This book demonstrated the limitations of single-layer perceptrons and motivated the development of multi-layer neural networks and backpropagation.}
}

@article{rumelhart1986learning,
  title     = {Learning representations by back-propagating errors},
  author    = {Rumelhart, David E. and Hinton, Geoffrey E. and Williams, Ronald J.},
  journal   = {Nature},
  volume    = {323},
  number    = {6088},
  pages     = {533--536},
  year      = {1986},
  publisher = {Nature Publishing Group},
  address   = {London, UK},
  doi       = {10.1038/323533a0},
  issn      = {0028-0836},
  url       = {https://www.nature.com/articles/323533a0},
  abstract  = {This seminal paper introduces the backpropagation algorithm for training multi-layer neural networks. The authors present a systematic method for computing gradients in deep networks by propagating errors backward through the layers. The algorithm enables the training of networks with multiple hidden layers, overcoming the limitations identified by Minsky and Papert. The paper provides the mathematical foundations for modern deep learning and demonstrates how backpropagation can be used to learn complex representations. This work revolutionized the field of neural networks and made possible the training of deep architectures that power modern AI systems.},
  keywords  = {backpropagation, deep learning, gradient descent, neural networks, error propagation, multi-layer networks},
  citation_count = {25000+},
  impact_factor = {revolutionary breakthrough in neural network training},
  note      = {This paper introduced the backpropagation algorithm, enabling the training of multi-layer neural networks and revolutionizing the field of deep learning.}
}

