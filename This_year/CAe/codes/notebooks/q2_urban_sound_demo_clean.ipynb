    "# Simple CNN and Wav2Vec-like models (as in demo)\n",
    "class AudioCNN(nn.Module):\n",
    "    def __init__(self, num_classes, input_shape=(128,431)):\n",
    "        super().__init__()\n",
    "        self.features = nn.Sequential(\n",
    "            nn.Conv2d(1,32,3,padding=1), nn.BatchNorm2d(32), nn.ReLU(), nn.MaxPool2d(2),\n",
    "            nn.Conv2d(32,64,3,padding=1), nn.BatchNorm2d(64), nn.ReLU(), nn.MaxPool2d(2),\n",
    "            nn.Conv2d(64,128,3,padding=1), nn.BatchNorm2d(128), nn.ReLU(), nn.AdaptiveAvgPool2d((4,4))\n",
    "        )\n",
    "        with torch.no_grad():\n",
    "            dummy = torch.randn(1,1,*input_shape)\n",
    "            flat = self.features(dummy).view(1,-1).size(1)\n",
    "        self.classifier = nn.Sequential(nn.Dropout(0.5), nn.Linear(flat,512), nn.ReLU(), nn.Dropout(0.5), nn.Linear(512,num_classes))\n",
    "    def forward(self,x):\n",
    "        x = self.features(x); x = x.view(x.size(0),-1); return self.classifier(x)\n",
    "\n",
    "class SimpleWav2VecClassifier(nn.Module):\n",
    "    def __init__(self,num_classes):\n",
    "        super().__init__()\n",
    "        self.feature_extractor = nn.Sequential(nn.Conv1d(1,128,10,stride=5), nn.ReLU(), nn.AdaptiveAvgPool1d(256))\n",
    "        self.transformer = nn.TransformerEncoder(nn.TransformerEncoderLayer(d_model=128,nhead=4), num_layers=3)\n",
    "        self.classifier = nn.Sequential(nn.Linear(128,256), nn.ReLU(), nn.Dropout(0.5), nn.Linear(256,num_classes))\n",
    "    def forward(self,x):\n",
    "        x = x.unsqueeze(1); f = self.feature_extractor(x).transpose(1,2); t = self.transformer(f); p = t.mean(dim=1); return self.classifier(p)\n",
    "print('Models defined')\n"
   ]
  },
