   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Inline UrbanSoundDataset (deterministic padding, spectrogram mode)\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "class UrbanSoundDataset(torch.utils.data.Dataset):\n",
    "    def __init__(self, dataframe, audio_dir, mode='spectrogram', spec_config=None, duration=4.0, sr=16000):\n",
    "        self.df = dataframe.reset_index(drop=True)\n",
    "        self.audio_dir = Path(audio_dir)\n",
    "        self.mode = mode\n",
    "        self.spec_config = spec_config or SPEC_CONFIG\n",
    "        self.duration = duration\n",
    "        self.sr = sr\n",
    "        self.le = LabelEncoder()\n",
    "        self.labels = self.le.fit_transform(self.df['class'])\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "    def load_audio(self, path):\n",
    "        y, sr = librosa.load(path, sr=self.sr, duration=self.duration)\n",
    "        target_len = int(self.duration * self.sr)\n",
    "        if len(y) < target_len:\n",
    "            y = np.pad(y, (0, target_len - len(y)))\n",
    "        else:\n",
    "            y = y[:target_len]\n",
    "        return y, sr\n",
    "    def audio_to_mel(self, y, sr):\n",
    "        mel = librosa.feature.melspectrogram(y=y, sr=sr, n_fft=self.spec_config['n_fft'],\n",
    "                                             hop_length=self.spec_config['hop_length'], n_mels=self.spec_config['n_mels'], fmax=self.spec_config['fmax'])\n",
    "        mel_db = librosa.power_to_db(mel, ref=np.max)\n",
    "        mel_db = (mel_db - mel_db.mean()) / (mel_db.std() + 1e-8)\n",
    "        return mel_db.astype(np.float32)\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        audio_path = self.audio_dir / f\"fold{row['fold']}\" / row['slice_file_name']\n",
    "        if not audio_path.exists():\n",
    "            # return dummy\n",
    "            if self.mode == 'spectrogram':\n",
    "                t = int(self.duration * self.sr / self.spec_config['hop_length'])+1\n",
    "                dummy = np.zeros((1, self.spec_config['n_mels'], t), dtype=np.float32)\n",
    "                return torch.tensor(dummy), torch.tensor(self.labels[idx], dtype=torch.long)\n",
    "            else:\n",
    "                return torch.zeros(int(self.duration*self.sr), dtype=torch.float32), torch.tensor(self.labels[idx], dtype=torch.long)\n",
    "        y, sr = self.load_audio(audio_path)\n",
    "        if self.mode == 'spectrogram':\n",
    "            spec = self.audio_to_mel(y, sr)\n",
    "            spec = np.expand_dims(spec, 0)\n",
    "            return torch.tensor(spec), torch.tensor(self.labels[idx], dtype=torch.long)\n",
    "        else:\n",
    "            return torch.tensor(y.astype(np.float32)), torch.tensor(self.labels[idx], dtype=torch.long)\n",
    "print('UrbanSoundDataset (clean) defined')\n"
   ]
