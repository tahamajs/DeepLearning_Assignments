    "# Sanity test with dummy data if dataset missing\n",
    "if not data_dir.exists():\n",
    "    print('Data not found — running dummy forward tests')\n",
    "    cnn = AudioCNN(num_classes=10).to(device)\n",
    "    wav = SimpleWav2VecClassifier(num_classes=10).to(device)\n",
    "    with torch.no_grad():\n",
    "        dummy_spec = torch.randn(2,1,SPEC_CONFIG['n_mels'],431).to(device)\n",
    "        print('CNN out', cnn(dummy_spec).shape)\n",
    "        dummy_raw = torch.randn(2,16000).to(device)\n",
    "        print('Wav2Vec-like out', wav(dummy_raw).shape)\n",
    "else:\n",
    "    print('Dataset folder present. Use original notebook cells to run full experiments.')\n"
   ]
