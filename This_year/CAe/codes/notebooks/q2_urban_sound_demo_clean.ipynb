    "# Configuration\n",
    "SPEC_CONFIG = {\n",
    "    'n_fft': 2048,\n",
    "    'hop_length': 512,\n",
    "    'n_mels': 128,\n",
    "    'fmax': 8000,\n",
    "    'duration': 4.0,\n",
    "}\n",
    "BATCH_SIZE = 16\n"
   ]
  },
