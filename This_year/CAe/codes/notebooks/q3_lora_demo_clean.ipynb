   "source": [
    "# Q3 (CLEAN): LoRA Fine-tuning — Self-contained Notebook\n",
    "\n",
    "This cleaned notebook provides a minimal, runnable LoRA demo (synthetic data), with a dependency guard for heavy packages (peft / bitsandbytes). It shows dataset creation, tokenization, PEFT guard, training loop scaffold, and evaluation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import random\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import DataLoader\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "SEED = 42\n",
    "random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print('Device:', device)\n",
    "notebook_dir = Path.cwd(); project_root = notebook_dir.parent\n",
    "output_dir = notebook_dir.parent / 'pictures'; output_dir.mkdir(exist_ok=True)\n",
    "timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dependency guard for PEFT / bitsandbytes\n",
    "try:\n",
    "    import peft\n",
    "    import bitsandbytes as bnb\n",
    "    from transformers import AutoTokenizer, AutoModelForCausalLM\n",
    "    _HAS_PEFT = True\n",
    "except Exception as e:\n",
    "    print('PEFT/bitsandbytes/transformers heavy libs not available:', e)\n",
    "    _HAS_PEFT = False\n",
    "print('_HAS_PEFT =', _HAS_PEFT)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Synthetic instruction dataset (small) and HF-like tokenization using a lightweight tokenizer\n",
    "from datasets import Dataset\n",
    "def create_synthetic(num=200):\n",
    "    insts = ['Explain', 'Describe', 'Summarize', 'Compare']\n",
    "    topics = ['AI','ML','DL','NLP']\n",
    "    data=[]\n",
    "    for i in range(num):\n",
    "        instr=f\"{np.random.choice(insts)} {np.random.choice(topics)}\"\n",
    "        resp='This is a synthetic response.'\n",
    "        data.append({'text':f'Instruction: {instr}\\nResponse: {resp}', 'instruction':instr, 'response':resp})\n",
    "    return Dataset.from_pandas(pd.DataFrame(data))\n",
    "hf_ds = create_synthetic(200)\n",
    "print('Synthetic dataset size:', len(hf_ds))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if _HAS_PEFT:\n",
    "    tokenizer = AutoTokenizer.from_pretrained('gpt2', use_fast=True)\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "    def tokenize_fn(batch):\n",
    "        return tokenizer(batch['text'], truncation=True, padding='max_length', max_length=128)\n",
    "    tokenized = hf_ds.map(tokenize_fn, batched=True)\n",
    "    # simple DataLoader from tokenized dataset\n",
    "    def collate(batch):\n",
    "        import torch\n",
    "        input_ids = torch.tensor([b['input_ids'] for b in batch])\n",
    "        return {'input_ids': input_ids, 'attention_mask': torch.ones_like(input_ids), 'labels': input_ids}\n",
    "    train_loader = DataLoader(tokenized.select(range(160)), batch_size=4, shuffle=True, collate_fn=collate)\n",
    "    val_loader = DataLoader(tokenized.select(range(160,200)), batch_size=4, shuffle=False, collate_fn=collate)\n",
    "    print('Tokenized and dataloaders ready')\n",
    "else:\n",
    "    print('PEFT not available — training cells will be skipped; synthetic examples available for inspection')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Minimal training loop scaffold (runs only if PEFT available)\n",
    "if _HAS_PEFT:\n",
    "    model = AutoModelForCausalLM.from_pretrained('gpt2')\n",
    "    from peft import LoraConfig, get_peft_model\n",
    "    lora_conf = LoraConfig(r=8, lora_alpha=16, target_modules=['c_attn'], lora_dropout=0.1, bias='none', task_type='CAUSAL_LM')\n",
    "    peft_model = get_peft_model(model, lora_conf)\n",
    "    peft_model.to(device)\n",
    "    opt = torch.optim.AdamW(peft_model.parameters(), lr=2e-4)\n",
    "    for epoch in range(1):\n",
    "        peft_model.train()\n",
    "        for batch in train_loader:\n",
    "            inputs = {k:v.to(device) for k,v in batch.items()}\n",
    "            outputs = peft_model(**inputs)\n",
    "            loss = outputs.loss\n",
    "            loss.backward(); opt.step(); opt.zero_grad()\n",
    "        print('Epoch done, loss:', loss.item())\n",
    "    print('PeFT demo training complete')\n",
    "else:\n",
    "    print('Skipped heavy training — PEFT not present')\n"
   ]
  }
 ],
